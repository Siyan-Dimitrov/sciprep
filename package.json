{
  "name": "sciprep",
  "version": "0.0.0",
  "private": true,
  "description": "Reasoning-first preparation for GAMSAT Biological and Physical Sciences",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "npm@10.9.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "postcss": "^8.5.24",
    "sharp": "^0.35.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace @sciprep/web",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "content:validate": "npm run content:validate --workspace @sciprep/content-schema",
    "audit:prod": "npm audit --omit=dev",
    "check": "npm run lint && npm run typecheck && npm run test && npm run content:validate && npm run build"
  }
}
