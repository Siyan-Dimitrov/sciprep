# Copy to keystore.properties (same directory) and fill in the real values.
#
# keystore.properties, and any *.jks / *.keystore file, are gitignored: the
# upload key is a secret and must never enter the repository.
#
# When keystore.properties is absent the release build still succeeds but the
# artifact is UNSIGNED - it is never signed with the debug key. See
# docs/RELEASE.md for how to create the keystore.

# Path to the keystore. Relative paths resolve against android/app/.
# An absolute path outside the working tree is preferred.
storeFile=../../../sciprep-upload-key.jks

# Password protecting the keystore file itself.
storePassword=CHANGE_ME

# Alias of the key inside the keystore.
keyAlias=sciprep-upload

# Password protecting that key. Often identical to storePassword.
keyPassword=CHANGE_ME
